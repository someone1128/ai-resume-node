{
  "name": "resume-node",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js backend for the resume platform migration",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:doubao": "tsx scripts/verify-doubao.ts",
    "bench:health": "tsx scripts/benchmark-health.ts",
    "audit": "pnpm audit --prod",
    "db:inspect": "tsx scripts/inspect-database.ts",
    "db:inspect:core": "tsx scripts/inspect-core-data.ts",
    "db:inspect:schema": "tsx scripts/inspect-schema.ts",
    "db:inspect:statuses": "tsx scripts/inspect-statuses.ts",
    "db:inspect:scheduled-jobs": "tsx scripts/inspect-scheduled-jobs.ts",
    "db:create-test-fixture": "tsx scripts/create-test-fixture.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.49",
    "@ai-sdk/openai-compatible": "3.0.53",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/multipart": "10.1.1",
    "@fastify/sensible": "6.0.5",
    "@fastify/websocket": "^11.3.1",
    "ai": "7.0.107",
    "cos-nodejs-sdk-v5": "3.0.0",
    "dotenv": "18.0.1",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "mammoth": "1.11.0",
    "mysql2": "3.24.4",
    "pdf-parse": "2.4.5",
    "pino": "10.3.1",
    "sm-crypto": "0.5.7",
    "ws": "^8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "@types/ws": "^8.18.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "tsc-alias": "1.8.16",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
