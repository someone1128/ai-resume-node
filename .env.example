NODE_ENV=development
PORT=8823
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3200

# Existing MySQL database. Do not put production values in this file.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=ai-resume
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_CONNECTION_LIMIT=10

REDIS_URL=redis://127.0.0.1:6379/2
REDIS_MAX_CONNECTIONS=16

# Only development/test. Production must reject these variables.
TEST_AUTH_ENABLED=false
TEST_USER_ID=
TEST_AUTH_TOKEN=
ADMIN_LOGIN_ENABLED=false
# 64 hexadecimal characters; keep the matching SM2 private key outside the repository.
ADMIN_SM2_PRIVATE_KEY=
ADMIN_TOKEN_TTL_SECONDS=86400
CLIENT_TOKEN_TTL_SECONDS=2592000

TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=
TENCENT_COS_BUCKET=
TENCENT_COS_PUBLIC_BASE_URL=

WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
WECHAT_REDIRECT_URI_OFFER=
WECHAT_REDIRECT_URI_PHOTO=
WECHAT_REDIRECT_URI_CAMPUS=
WECHAT_MP_REDIRECT_URI_CAMPUS=
FRONT_REDIRECT_URI=
FRONT_REDIRECT_URI_OFFER=
FRONT_REDIRECT_URI_PHOTO=
FRONT_REDIRECT_URI_CAMPUS=
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=
PAYMENT_MODE=mock

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_TEXT_MODEL=
DOUBAO_IMAGE_MODEL=
DOUBAO_IMAGE_SIZE=2048x2048
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_INPUT_LENGTH=3000
AI_MAX_OUTPUT_TOKENS=4000

# Crash recovery for AI photo records left in PROCESSING. Keep disabled until
# the deployment has reviewed the job and its database permissions.
PHOTO_COMPENSATION_ENABLED=false
PHOTO_COMPENSATION_INTERVAL_MS=300000
PHOTO_COMPENSATION_STALE_MINUTES=15

# Database inspection/fixture scripts only. Fixture writes require an explicit
# ALLOW_TEST_FIXTURE_WRITE=true and are blocked when NODE_ENV=production.
INSPECT_DB_HOST=127.0.0.1
INSPECT_DB_PORT=3306
INSPECT_DB_NAME=ai-resume
INSPECT_DB_USER=
INSPECT_DB_PASSWORD=
ALLOW_TEST_FIXTURE_WRITE=false
FIXTURE_DRY_RUN=false
